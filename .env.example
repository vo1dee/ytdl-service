# YouTube Download Service Environment Configuration
# Copy this file to .env and customize the values as needed

# === Required Configuration ===
# Service URL for internal communication (used by Telegram bot)
# Default: http://localhost:8000
YTDL_SERVICE_URL=http://localhost:8000

# API key for service authentication (leave empty for auto-generation)
# If not provided, a random key will be generated and stored in API_KEY_FILE
YTDL_SERVICE_API_KEY=

# === Service Configuration ===
# Port for the FastAPI service
# Default: 8000
PORT=8000

# Download retry configuration
# Number of retry attempts for failed downloads
# Default: 3
YTDL_MAX_RETRIES=3

# Delay between retry attempts (in seconds)
# Default: 1
YTDL_RETRY_DELAY=1

# === Directory Configuration ===
# Directory paths (container paths - do not change unless you know what you're doing)
# Downloads directory path inside container
# Default: /opt/ytdl_service/downloads
DOWNLOADS_DIR=/opt/ytdl_service/downloads

# Logs directory path inside container
# Default: /var/log
LOGS_DIR=/var/log

# API key file path inside container
# Default: /opt/ytdl_service/config/api_key.txt
API_KEY_FILE=/opt/ytdl_service/config/api_key.txt

# === Security Configuration ===
# Security hardening mode (true/false)
# Default: true
SECURITY_HARDENING=true

# File permissions umask (octal format)
# Default: 0027 (restrictive permissions)
UMASK=0027

# Enable security scanning (true/false)
# Default: false
SECURITY_SCAN_ENABLED=false

# Security scan interval (in seconds)
# Default: 86400 (24 hours)
SECURITY_SCAN_INTERVAL=86400

# === Maintenance Configuration ===
# yt-dlp update check interval (in seconds)
# Default: 86400 (24 hours)
YTDLP_UPDATE_INTERVAL=86400

# File cleanup interval (in seconds)
# Default: 3600 (1 hour)
CLEANUP_INTERVAL=3600

# Maximum age for downloaded files before cleanup (in seconds)
# Default: 86400 (24 hours)
FILE_MAX_AGE=86400

# === Telegram Bot Configuration (Optional) ===
# Telegram bot token (required if using the Telegram bot)
TELEGRAM_BOT_TOKEN=

# Chat ID for error reporting (optional)
TELEGRAM_ERROR_CHAT_ID=

# === Advanced Configuration ===
# Debug mode (true/false)
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# === Docker Compose Specific ===
# External port mapping (change if port 8000 is already in use)
EXTERNAL_PORT=8000

# Volume paths (host paths - customize as needed)
DOWNLOADS_HOST_PATH=./downloads
LOGS_HOST_PATH=./logs
CONFIG_HOST_PATH=./config