# YouTube Download Service Environment Configuration
# Copy this file to .env and customize the values as needed

# === Required Configuration ===
# Service URL for internal communication (used by Telegram bot)
YTDL_SERVICE_URL=http://localhost:8000

# API key for service authentication (leave empty for auto-generation)
YTDL_SERVICE_API_KEY=

# === Service Configuration ===
# Port for the FastAPI service
PORT=8000

# Download retry configuration
YTDL_MAX_RETRIES=3
YTDL_RETRY_DELAY=1

# === Directory Configuration ===
# Directory paths (container paths - do not change unless you know what you're doing)
DOWNLOADS_DIR=/opt/ytdl_service/downloads
LOGS_DIR=/var/log
API_KEY_FILE=/opt/ytdl_service/config/api_key.txt

# === Telegram Bot Configuration (Optional) ===
# Telegram bot token (required if using the Telegram bot)
TELEGRAM_BOT_TOKEN=

# Chat ID for error reporting (optional)
TELEGRAM_ERROR_CHAT_ID=

# === Advanced Configuration ===
# Debug mode (true/false)
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# === Docker Compose Specific ===
# External port mapping (change if port 8000 is already in use)
EXTERNAL_PORT=8000

# Volume paths (host paths - customize as needed)
DOWNLOADS_HOST_PATH=./downloads
LOGS_HOST_PATH=./logs
CONFIG_HOST_PATH=./config